    alias: "jamesylj"
    website: "https://github.com/jamesylj"
repository-code: "https://github.com/jamesylj/llm-reasoning-discipline"
url: "https://github.com/jamesylj/llm-reasoning-discipline"
license: MIT
date-released: "2026-10-01"
keywords:
  - LLM reasoning
  - chain-of-thought faithfulness
  - prompt engineering
  - logical atomism
  - Tractatus Logico-Philosophicus
  - evaluation harness
  - measurement validity
